{
  "name": "firebim-webapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "generate:api": "openapi-typescript openapi.json --output src/types/api.ts",
    "test:rulebook-diagnostic": "node scripts/verify-rulebook-diagnostic.mjs",
    "test:api-access": "node scripts/verify-api-access.mjs",
    "test:merge-safety": "pnpm lint && pnpm exec tsc --noEmit && pnpm run test:api-access && pnpm run test:rulebook-diagnostic"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.0.1",
    "@ifc-lite/geometry": "^1.18.5",
    "@ifc-lite/parser": "^2.4.1",
    "@ifc-lite/renderer": "^1.20.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/react-query": "^5.100.10",
    "@xyflow/react": "^12.10.1",
    "axios": "^1.16.1",
    "next": "16.2.6",
    "html-to-image": "^1.11.13",
    "next-auth": "^4.24.14",
    "openapi-typescript": "^7.8.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.75.0",
    "react-toastify": "^11.1.0",
    "zod": "^3.25.20",
    "zustand": "^4.5.7"
  },
  "overrides": {
    "form-data": ">=4.0.4",
    "minimatch": "^5.1.8",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "picomatch": ">=4.0.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
