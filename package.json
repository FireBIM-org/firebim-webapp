{
  "name": "firebim-webapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "tsc": "tsc --noEmit",
    "generate:api": "openapi-typescript openapi.json --output src/types/api.ts && oxfmt src/types/api.ts",
    "test:rulebook-diagnostic": "node scripts/verify-rulebook-diagnostic.mjs",
    "test:api-access": "node scripts/verify-api-access.mjs",
    "test": "vitest run",
    "test:merge-safety": "pnpm lint && pnpm exec tsc --noEmit && pnpm run test:api-access && pnpm run test:rulebook-diagnostic"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.7.1",
    "@ifc-lite/data": "^2.5.0",
    "@ifc-lite/geometry": "^1.18.5",
    "@ifc-lite/parser": "^2.4.1",
    "@ifc-lite/renderer": "^1.41.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.11.2",
    "axios": "^1.20.0",
    "html-to-image": "^1.11.13",
    "next": "16.3.8",
    "next-auth": "^4.24.15",
    "openapi-typescript": "^7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.84.0",
    "react-toastify": "^11.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "form-data": ">=4.0.4",
    "minimatch": "^5.1.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "picomatch": ">=4.0.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
