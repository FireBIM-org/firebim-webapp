{
  "name": "firebim-webapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate:api": "openapi-typescript openapi.json --output src/types/api.ts",
    "test:rulebook-diagnostic": "node scripts/verify-rulebook-diagnostic.mjs",
    "test:api-access": "node scripts/verify-api-access.mjs",
    "test:merge-safety": "pnpm lint && pnpm exec tsc --noEmit && pnpm run test:api-access && pnpm run test:rulebook-diagnostic"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.0.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/react-query": "^5.76.1",
    "@xyflow/react": "^12.10.1",
    "axios": "^1.15.0",
    "html-to-image": "^1.11.13",
    "next": "^15.5.15",
    "next-auth": "^4.24.13",
    "openapi-typescript": "^7.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.56.4",
    "react-toastify": "^11.0.5",
    "zustand": "^4.5.7",
    "zod": "^3.25.20"
  },
  "overrides": {
    "form-data": ">=4.0.4",
    "minimatch": "^5.1.8",
    "picomatch": ">=4.0.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.15",
    "tailwindcss": "^4.1.7",
    "typescript": "^5"
  }
}
