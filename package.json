{
  "name": "firebim-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format:fix": "oxfmt src/",
    "format": "oxfmt --check src/",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "tsc:noEmit": "tsc --noEmit",
    "check": "npm run format && npm run lint && npm run tsc:noEmit",
    "fix": "npm run format:fix && npm run lint:fix",
    "generate:api": "openapi-typescript openapi.json --output src/types/api.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.0.1",
    "@ifc-lite/parser": "^2.1.9",
    "@ifc-lite/renderer": "^1.15.3",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/react-query": "^5.76.1",
    "axios": "^1.13.5",
    "next": "16.2.3",
    "next-auth": "^4.24.13",
    "openapi-typescript": "^7.8.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.56.4",
    "react-toastify": "^11.0.5"
  },
  "overrides": {
    "form-data": ">=4.0.4",
    "minimatch": "^5.1.8",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.9.3"
  }
}
