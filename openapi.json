    "/async/check-model-with-ids": {
      "post": {
        "summary": "Async Check Model With Ids",
        "description": "Asynchronously check a model against an IDS file.\nReturns immediately with a task ID for polling the result.\n\nThis endpoint demonstrates the first requested pattern:\n\"Call that returns immediately with id for polling if result is ready. Task is sent to worker.\"",
        "operationId": "async_check_model_with_ids_async_check_model_with_ids_post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "model_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Model Id"
            }
          },
          {
            "name": "ids_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ids Id"
            }
          }
        ],
        "responses": {
