    "/ifc-models/{model_id}/check": {
      "get": {
        "summary": "Sync Check Model With Ids",
        "description": "Synchronously check a model against an IDS file.\nWaits for the worker to complete and returns the result.\n\nThis endpoint demonstrates the second requested pattern:\n\"Call that waits for the worker to return with the result.\"",
        "operationId": "sync_check_model_with_ids_ifc_models__model_id__check_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "required": true,
