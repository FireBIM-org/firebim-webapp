            }
          },
          {
            "name": "ids_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ids Id"
            }
          },
          {
            "name": "timeout",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "Timeout in seconds",
              "default": 300,
              "title": "Timeout"
            },
            "description": "Timeout in seconds"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
