# Example environment variables. Copy this file to .env and fill in the values.

# API Configuration
# NEXT_PUBLIC_API_HOST is the base URL that the browser uses for API calls.
# In local dev, the webapp itself proxies requests, so leave this empty or use /.
NEXT_PUBLIC_API_HOST=

# API_BACKEND_URL is used by the server-side proxy route to reach the FastAPI backend
API_BACKEND_URL=http://localhost:8000

# API proxy limits (optional, defaults shown).
# Max wait for the API's response headers, counted after the request body has been sent.
# API_PROXY_TIMEOUT_MS=120000
# Max request body the proxy forwards (500 MiB, same as the API's MAX_UPLOAD_BYTES) → 413.
# API_PROXY_MAX_BODY_BYTES=524288000

# OpenTelemetry (optional). Without an OTLP endpoint, telemetry is a complete no-op.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=firebim-webapp
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_SDK_DISABLED=false

# Traefik Configuration
# Host for the web application (default: app.firebim.org)
TRAEFIK_HOST=app.firebim.org
# Email address for Let's Encrypt notifications (default: contact@firebim.org)
TRAEFIK_ACME_EMAIL=contact@firebim.org

# Umami analytics configuration
NEXT_PUBLIC_UMAMI_ANALYTICS_WEBSITE_ID=change-me-ignore-local-XXXX-XXXX-XXXXXXXXXXXX

# Authentication (NextAuth + Authentik)
# NEXTAUTH_URL should match the canonical URL users access the app from
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-random-secret
AUTHENTIK_CLIENT_ID=firebim
AUTHENTIK_CLIENT_SECRET=local-dev-client-secret
AUTHENTIK_ISSUER_URL=http://localhost:9080/application/o/firebim/
# Optional: server-side URL for token refresh. Set this to the cluster-internal address
# in Docker / K8s so the Next.js server doesn't need to reach the public Authentik URL.
# Falls back to AUTHENTIK_ISSUER_URL if not set.
# Example (K8s): http://authentik-server.authentik.svc.cluster.local/application/o/firebim/
AUTHENTIK_INTERNAL_ISSUER_URL=
