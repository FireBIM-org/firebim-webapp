# Example environment variables. Copy this file to .env and fill in the values.

# API Configuration
# NEXT_PUBLIC_API_HOST is the base URL that the browser uses for API calls.
# In local dev, the webapp itself proxies requests, so leave this empty or use /.
NEXT_PUBLIC_API_HOST=

# API_BACKEND_URL is used by the server-side proxy route to reach the FastAPI backend
API_BACKEND_URL=http://localhost:8000

# Traefik Configuration
# Host for the web application (default: app.firebim.org)
TRAEFIK_HOST=app.firebim.org
# Email address for Let's Encrypt notifications (default: contact@firebim.org)
TRAEFIK_ACME_EMAIL=contact@firebim.org

# Umami analytics configuration
NEXT_PUBLIC_UMAMI_ANALYTICS_WEBSITE_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Authentication (NextAuth + Authentik)
# NEXTAUTH_URL should match the canonical URL users access the app from
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-random-secret
AUTHENTIK_CLIENT_ID=firebim
AUTHENTIK_CLIENT_SECRET=your-client-secret-here
AUTHENTIK_ISSUER_URL=http://localhost:9090/application/o/firebim/
